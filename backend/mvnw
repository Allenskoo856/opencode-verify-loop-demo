#!/bin/sh
set -eu
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION=3.9.9
MAVEN_HOME="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="$MAVEN_HOME/bin/mvn"
if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven ${MAVEN_VERSION} is not installed. In CI use setup-java/cache or run the wrapper bootstrap with network access." >&2
  exit 2
fi
exec "$MAVEN_BIN" -f "$BASE_DIR/pom.xml" "$@"
