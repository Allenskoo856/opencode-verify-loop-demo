{
  "schemaVersion": "verify/policy/v1",
  "protected": [
    ".opencode/**",
    "docs/tasks/**",
    "e2e/specs/**",
    "frontend/e2e/**",
    "acceptance/specs/**",
    "acceptance/project.json",
    "verify/policy.json",
    "verify/gates/**",
    "offline/SHA256SUMS"
  ],
  "defaults": { "timeoutSeconds": 1200 },
  "profiles": {
    "auto": ["git-diff", "frontend-build", "controller-node-test"],
    "backend": ["git-diff", "backend-project-test"],
    "frontend": ["git-diff", "frontend-project-unit"],
    "frontend-e2e": ["git-diff", "frontend-project-e2e"],
    "api": ["git-diff", "api-contract-spec"],
    "full": ["git-diff", "backend-project-test", "frontend-project-unit", "compose-playwright-e2e"],
    "staging": ["staging-target-guard", "staging-health", "api-contract-spec", "staging-browser-e2e"]
  },
  "gates": {
    "git-diff": { "runner": "shell", "command": "git diff --check" },
    "frontend-build": { "runner": "project", "project": "acceptance/project.json", "target": "frontend.build" },
    "controller-node-test": { "runner": "shell", "command": "npm --prefix verify-controller-ts ci --ignore-scripts && npm --prefix verify-controller-ts run test" },
    "backend-project-test": { "runner": "project", "project": "acceptance/project.json", "target": "backend.test" },
    "frontend-project-unit": { "runner": "project", "project": "acceptance/project.json", "target": "frontend.unit" },
    "frontend-project-e2e": {
      "runner": "project",
      "project": "acceptance/project.json",
      "target": "frontend.e2e",
      "requires": { "E2E_BASE_URL": "present", "E2E_USER": "present", "E2E_PASSWORD": "present" }
    },
    "api-contract-spec": {
      "runner": "contract",
      "spec": "acceptance/specs/orders-api.json",
      "timeoutSeconds": 120,
      "requires": {
        "TARGET_ENV": "present",
        "ALLOW_MUTATING_E2E": "true",
        "API_BASE_URL": "present",
        "E2E_USER": "present",
        "E2E_PASSWORD": "present"
      }
    },
    "compose-playwright-e2e": { "runner": "shell", "command": "bash verify/gates/compose-e2e.sh", "timeoutSeconds": 1800 },
    "staging-target-guard": { "runner": "module", "module": "verify/gates/staging-target-guard.cjs", "requires": { "TARGET_ENV": "staging", "ALLOW_MUTATING_E2E": "true" } },
    "staging-health": { "runner": "http", "url": "${STAGING_HEALTH_URL}", "expectedStatus": 200, "requires": { "TARGET_ENV": "staging", "STAGING_HEALTH_URL": "present" } },
    "staging-api-contract": { "runner": "contract", "spec": "acceptance/specs/orders-api.json", "requires": { "TARGET_ENV": "staging", "ALLOW_MUTATING_E2E": "true", "API_BASE_URL": "present", "E2E_USER": "present", "E2E_PASSWORD": "present" } },
    "staging-browser-e2e": { "runner": "project", "project": "acceptance/project.json", "target": "frontend.e2e", "requires": { "TARGET_ENV": "staging", "ALLOW_MUTATING_E2E": "true", "E2E_BASE_URL": "present", "E2E_USER": "present", "E2E_PASSWORD": "present" } }
  }
}
